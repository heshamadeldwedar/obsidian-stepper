{
  "name": "obsidian-stepper",
  "version": "0.1.0",
  "description": "Obsidian plugin: write a small YAML block, get an animated step-by-step isometric diagram.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "test": "node --test tests/*.test.js",
    "icons": "node tools/build-icons.js",
    "preview": "node esbuild.config.js --preview"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.24.0",
    "lucide-static": "0.460.0",
    "obsidian": "1.7.2"
  }
}
